{
  "name": "nekofin",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "APP_VARIANT=development expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ios:stroke-text": "bash modules/stroke-text/tests/run-ios-tests.sh",
    "test:ios:player-scrubber": "bash modules/player-scrubber/tests/run-ios-tests.sh",
    "test:ios:player-scrubber-ui": "bash modules/player-scrubber/tests/run-ios-ui-tests.sh",
    "test:smoke": "vitest run smoke",
    "test:watch": "vitest",
    "test:ota": "node --test scripts/ota/*.test.mjs updates/server/lib/*.test.mjs",
    "lint": "lint-staged",
    "prepare": "husky",
    "lint:commit": "commitlint --edit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.23",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.4.0",
    "@jellyfin/sdk": "^0.13.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-menu/menu": "2.0.0",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "axios": "^1.17.0",
    "dayjs": "^1.11.23",
    "expo": "~57.0.28",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-brightness": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-mpv": "0.1.14",
    "expo-navigation-bar": "~57.0.3",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-screen-orientation": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.77.0",
    "react-native": "0.86.3",
    "react-native-awesome-slider": "^2.9.0",
    "react-native-drawer-layout": "^4.2.4",
    "react-native-easing-gradient": "^1.1.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-ios-context-menu": "^3.2.1",
    "react-native-ios-utilities": "^5.2.0",
    "react-native-mmkv": "^3.3.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-pager-view": "8.0.2",
    "react-native-performance-toolkit": "^0.3.1",
    "react-native-reanimated": "4.5.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-uuid": "^2.0.3",
    "react-native-video": "^6.19.2",
    "react-native-volume-manager": "^2.0.8",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "semver": "^7.8.5",
    "zeego": "^3.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/react": "~19.2.16",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "prettier": "3.6.2",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  },
  "private": true,
  "packageManager": "bun@1.2.21",
  "overrides": {
    "expo-constants": "~57.0.21"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-ui"
        ]
      }
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true
    }
  },
  "patchedDependencies": {
    "react-native-ios-utilities@5.2.0": "patches/react-native-ios-utilities@5.2.0.patch",
    "expo-linear-gradient@57.0.2": "patches/expo-linear-gradient@57.0.2.patch",
    "react-native-ios-context-menu@3.2.1": "patches/react-native-ios-context-menu@3.2.1.patch",
    "react-native-screens@4.26.2": "patches/react-native-screens@4.26.2.patch",
    "@expo/ui@57.0.23": "patches/@expo-ui@57.0.23.patch"
  }
}
