+                    setPropertyBooleanLocked("pause", true)
+                    attachedSurface = null
+                    updateSurfaceLocked()
+                }
+            } finally {
+                // Complete even if release raced the preparation.
+                mainHandler.post { onReady() }
+            }
+        }
