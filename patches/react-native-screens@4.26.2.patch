+
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewConfiguration
+
+/** Shared native long-press/drag lifecycle for phone and tablet navigation. */
+class NavigationTabScrubber(private val host: View, private val delegate: Delegate) {
+    interface Delegate {
+        fun canStart(x: Float, y: Float): Boolean
+        fun onPressStarted(x: Float, y: Float)
+        fun onPressReleased()
+        fun cancelChildTouch(event: MotionEvent)
+        fun onScrubStarted(downX: Float, x: Float)
+        fun onScrubMoved(x: Float)
+        fun onScrubFinished(commit: Boolean)
+    }
+
+    var isScrubbing = false
+        private set
+    private var tracking = false
+    private var downX = 0f
+    private var x = 0f
+    private var y = 0f
+    private var downTime = 0L
+    private val startScrubbing = Runnable {
+        if (tracking && !isScrubbing) {
+            isScrubbing = true
+            host.parent?.requestDisallowInterceptTouchEvent(true)
+            val cancel = MotionEvent.obtain(downTime, android.os.SystemClock.uptimeMillis(), MotionEvent.ACTION_CANCEL, x, y, 0)
+            delegate.cancelChildTouch(cancel)
+            cancel.recycle()
+            delegate.onPressReleased()
+            delegate.onScrubStarted(downX, x)
+        }
+    }
+
+    /** Returns true only after taking over the native button's touch stream. */
+    fun onTouchEvent(event: MotionEvent): Boolean {
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                cancel()
+                if (!delegate.canStart(event.x, event.y)) return false
+                tracking = true
+                downX = event.x
+                x = event.x
+                y = event.y
+                downTime = event.downTime
+                delegate.onPressStarted(x, y)
+                host.postDelayed(startScrubbing, ViewConfiguration.getLongPressTimeout() * 3L / 4L)
+            }
+            MotionEvent.ACTION_MOVE -> {
+                if (!tracking) return false
+                x = event.x
+                y = event.y
+                if (isScrubbing) {
+                    delegate.onScrubMoved(x)
+                    return true
+                }
+            }
+            MotionEvent.ACTION_POINTER_DOWN, MotionEvent.ACTION_CANCEL -> return finish(false)
+            MotionEvent.ACTION_UP -> {
+                if (isScrubbing) delegate.onScrubMoved(event.x)
+                return finish(true)
+            }
+        }
+        return false
+    }
+
+    private fun finish(commit: Boolean): Boolean {
+        if (!tracking && !isScrubbing) return false
+        tracking = false
+        host.removeCallbacks(startScrubbing)
+        delegate.onPressReleased()
+        val consumed = isScrubbing
+        isScrubbing = false
+        if (consumed) delegate.onScrubFinished(commit)
+        return consumed
+    }
+
+    fun cancel() { finish(false) }
+
+    /** Detach/configuration cleanup, without starting a settling animation. */
+    fun reset() {
+        host.removeCallbacks(startScrubbing)
+        tracking = false
+        isScrubbing = false
+        delegate.onPressReleased()
+    }
+}
