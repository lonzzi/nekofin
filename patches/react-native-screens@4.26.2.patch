+
+/** The native tab items stay sharp; only the content behind the bar is blurred. */
+internal class TabsBackdropView(
+    context: Context,
+    source: BlurTarget,
+) : BlurView(context) {
+    private val clearDrawable = ColorDrawable(Color.WHITE)
+    private val fadePaint = Paint().apply {
+        xfermode = PorterDuffXfermode(PorterDuff.Mode.DST_IN)
+    }
+    private val tintPaint = Paint()
+    private var tintColor = Color.WHITE
+
+    init {
+        importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+        isClickable = false
+        isFocusable = false
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            setupWith(source)
+                .setFrameClearDrawable(clearDrawable)
+                .setBlurRadius(20f)
+        }
+    }
+
+    fun setSurfaceColor(color: Int) {
+        tintColor = color
+        clearDrawable.color = color
+        updateGradients()
+        invalidate()
+    }
+
+    override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
+        super.onSizeChanged(w, h, oldw, oldh)
+        updateGradients()
+    }
+
+    private fun updateGradients() {
+        if (height <= 0) return
+        val fadeHeight = (28f * resources.displayMetrics.density).coerceAtMost(height.toFloat())
+        fadePaint.shader = LinearGradient(
+            0f, 0f, 0f, fadeHeight,
+            Color.TRANSPARENT, Color.WHITE, Shader.TileMode.CLAMP,
+        )
+        tintPaint.shader = LinearGradient(
+            0f, 0f, 0f, height.toFloat(),
+            intArrayOf(
+                ColorUtils.setAlphaComponent(tintColor, 0),
+                ColorUtils.setAlphaComponent(tintColor, 105),
+                ColorUtils.setAlphaComponent(tintColor, 215),
+            ),
+            floatArrayOf(0f, 0.45f, 1f),
+            Shader.TileMode.CLAMP,
+        )
+    }
+
+    override fun draw(canvas: Canvas) {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            val layer = canvas.saveLayer(0f, 0f, width.toFloat(), height.toFloat(), null)
+            super.draw(canvas)
+            canvas.drawRect(0f, 0f, width.toFloat(), height.toFloat(), fadePaint)
+            canvas.restoreToCount(layer)
+        }
+        // Older devices retain the gradient, without enabling a software blur capture loop.
+        canvas.drawRect(0f, 0f, width.toFloat(), height.toFloat(), tintPaint)
+    }
+}
