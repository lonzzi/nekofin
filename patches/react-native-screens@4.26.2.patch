+/** Only sample the content sibling: tabs must never capture or blur themselves. */
+internal class TabsBackdropView(context: Context, private val source: CroppedBlurTarget) : BlurView(context) {
+    companion object {
+        const val BLUR_RADIUS = 20f
+        const val BLUR_SCALE_FACTOR = 4f
+    }
+
+    private val clearDrawable = ColorDrawable(Color.WHITE)
+    private val tintPaint = Paint()
+    private val strokePaint =
+        Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeWidth = resources.displayMetrics.density
+        }
+
+    init {
+        importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+        isClickable = false
+        isFocusable = false
+        outlineProvider = CapsuleOutlineProvider
+        clipToOutline = true
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            setupWith(source, BLUR_SCALE_FACTOR, true).setFrameClearDrawable(clearDrawable).setBlurRadius(BLUR_RADIUS)
+        }
+    }
+
+    fun setSurfaceColor(color: Int) {
+        clearDrawable.color = color
+        val dark = ColorUtils.calculateLuminance(color) < 0.5
+        // Android 12+ uses GPU blur. Older versions retain a readable solid capsule.
+        tintPaint.color =
+            ColorUtils.setAlphaComponent(color, if (Build.VERSION.SDK_INT >= 31) 210 else 245)
+        strokePaint.color =
+            ColorUtils.setAlphaComponent(
+                if (dark) Color.WHITE else Color.BLACK,
+                if (dark) 18 else 10
+            )
+        invalidate()
+    }
+
+    override fun draw(canvas: Canvas) {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            if (canvas.isHardwareAccelerated) source.updateSnapshot()
+            super.draw(canvas)
+        }
+        canvas.drawColor(tintPaint.color)
+        val halfStroke = strokePaint.strokeWidth / 2f
+        val radius =
+            CapsuleOutlineProvider.radius(
+                width - strokePaint.strokeWidth,
+                height - strokePaint.strokeWidth
+            )
+        canvas.drawRoundRect(
+            halfStroke,
+            halfStroke,
+            width - halfStroke,
+            height - halfStroke,
+            radius,
+            radius,
+            strokePaint
+        )
