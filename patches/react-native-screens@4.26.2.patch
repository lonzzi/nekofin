+package eightbitlab.com.blurview;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.RecordingCanvas;
+import android.os.Build;
+import android.view.View;
+import androidx.annotation.RequiresApi;
+
+/** A body-only source; the native stack toolbar is outside the owning Screen. */
+@SuppressLint("ViewConstructor")
+public final class ScreenBlurTarget extends BlurTarget {
+    private final View owner;
+    public ScreenBlurTarget(Context context, View owner) { super(context); this.owner = owner; }
+    @Override public void getLocationOnScreen(int[] location) { owner.getLocationOnScreen(location); }
+    public interface DrawChildren { void draw(Canvas canvas); }
+    @RequiresApi(Build.VERSION_CODES.S)
+    public void drawBody(Canvas destination, DrawChildren children) {
+        renderNode.setPosition(0, 0, owner.getWidth(), owner.getHeight());
+        RecordingCanvas recording = renderNode.beginRecording();
+        try { children.draw(recording); } finally { renderNode.endRecording(); }
+        destination.drawRenderNode(renderNode);
+    }
+}
