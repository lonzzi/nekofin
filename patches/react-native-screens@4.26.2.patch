+package com.swmansion.rnscreens.gamma.tabs.container
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.os.Build
+import android.view.View
+import android.view.ViewTreeObserver
+import android.graphics.Rect
+import android.widget.FrameLayout
+import androidx.core.graphics.ColorUtils
+import eightbitlab.com.blurview.BlurTarget
+import eightbitlab.com.blurview.CroppedBlurTarget
+
+/** One content-only GPU material shared by phone bottom tabs and tablet top controls. */
+class NavigationGlassView(context: Context, source: BlurTarget) : FrameLayout(context) {
+    private val samplePadding = (3 * 20f * 4f + 16 * resources.displayMetrics.density).toInt()
+    private val sample = CroppedBlurTarget(context, source).apply {
+        visibility = View.INVISIBLE
+        importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+    }
+    private val material = NavigationGlassBackdrop(context, sample)
+
+    init {
+        importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO
+        isClickable = false
+        isFocusable = false
+        outlineProvider = CapsuleOutlineProvider
+        clipToOutline = true
+        addView(sample, LayoutParams(0, 0))
+        addView(material, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
+    }
+
+    fun setDrawerShape(enabled: Boolean) {
+        clipToOutline = !enabled
+        material.setDrawerShape(enabled)
+    }
+
+    fun setCornerRadius(radius: Float) {
+        clipToOutline = false
+        material.setCornerRadius(radius)
+    }
+
+    fun setSurfaceColor(color: Int) = material.setSurfaceColor(color)
+
+    fun setTrailingSegment(width: Float, gap: Float) = material.setTrailingSegment(width, gap)
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        (sample.layoutParams as LayoutParams).apply {
+            width = MeasureSpec.getSize(widthMeasureSpec) + samplePadding * 2
+            height = MeasureSpec.getSize(heightMeasureSpec) + samplePadding * 2
+            leftMargin = -samplePadding
+            topMargin = -samplePadding
+        }
+        super.onMeasure(widthMeasureSpec, heightMeasureSpec)
+    }
+}
+
+private class NavigationGlassBackdrop(context: Context, private val source: CroppedBlurTarget) : View(context) {
+    private var clearColor = Color.WHITE
+    private val visibleBounds = Rect()
+    private val updateSnapshot = ViewTreeObserver.OnPreDrawListener {
+        if (Build.VERSION.SDK_INT >= 31 && isShown && getGlobalVisibleRect(visibleBounds)) {
+            source.updateBlurredSnapshot(clearColor, drawer)
+        }
+        true
+    }
+    private val tintPaint = Paint()
+    private val shape = Path()
+    private val bounds = RectF()
+    private var drawer = false
+    private var cornerRadius = -1f
+    private var trailingWidth = 0f
+    private var trailingGap = 0f
+    private val strokePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.STROKE
+        strokeWidth = resources.displayMetrics.density
+    }
+
+    init { setWillNotDraw(false); setSurfaceColor(Color.WHITE) }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        viewTreeObserver.addOnPreDrawListener(updateSnapshot)
+    }
+
+    override fun onDetachedFromWindow() {
+        viewTreeObserver.removeOnPreDrawListener(updateSnapshot)
+        super.onDetachedFromWindow()
+    }
+
+    fun setSurfaceColor(color: Int) {
+        clearColor = color
+        val dark = ColorUtils.calculateLuminance(color) < 0.5
+        // Older Android versions retain the same shape with an opaque fallback.
+        tintPaint.color = ColorUtils.setAlphaComponent(color, if (Build.VERSION.SDK_INT >= 31) 185 else 245)
+        strokePaint.color = ColorUtils.setAlphaComponent(if (dark) Color.WHITE else Color.BLACK, if (dark) 22 else 14)
+        invalidate()
+    }
+
+    fun setCornerRadius(radius: Float) {
+        cornerRadius = radius
+        updateShape()
+        invalidate()
+    }
+
+    fun setDrawerShape(enabled: Boolean) {
+        drawer = enabled
+        updateShape()
+        invalidate()
+    }
+
+    fun setTrailingSegment(width: Float, gap: Float) {
+        trailingWidth = width
+        trailingGap = gap
+        updateShape()
+        invalidate()
+    }
+
+    override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
+        super.onSizeChanged(w, h, oldw, oldh)
+        updateShape()
+    }
+
+    private fun updateShape() {
+        shape.reset()
+        val radius = if (cornerRadius >= 0f) cornerRadius else height / 2f
+        if (drawer) {
+            val corner = 28 * resources.displayMetrics.density
+            bounds.set(0f, 0f, width.toFloat(), height.toFloat())
+            shape.addRoundRect(bounds, floatArrayOf(0f, 0f, corner, corner, corner, corner, 0f, 0f), Path.Direction.CW)
+        } else if (trailingWidth > 0f) {
+            bounds.set(0f, 0f, (width - trailingWidth - trailingGap).coerceAtLeast(0f), height.toFloat())
+            shape.addRoundRect(bounds, radius, radius, Path.Direction.CW)
+            bounds.set(width - trailingWidth, 0f, width.toFloat(), height.toFloat())
+            shape.addRoundRect(bounds, radius, radius, Path.Direction.CW)
+        } else {
+            bounds.set(0f, 0f, width.toFloat(), height.toFloat())
+            shape.addRoundRect(bounds, radius, radius, Path.Direction.CW)
+        }
+    }
+
+    override fun draw(canvas: Canvas) {
+        val saved = canvas.save()
+        canvas.clipPath(shape)
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            if (canvas.isHardwareAccelerated) {
+                source.updateBlurredSnapshot(clearColor, drawer)
+                source.drawBlurredSnapshot(canvas, this)
+            }
+        }
+        canvas.drawColor(tintPaint.color)
+        if (drawer || cornerRadius >= 0f) {
+            canvas.drawPath(shape, strokePaint)
+            canvas.restoreToCount(saved)
+            return
+        }
+        val halfStroke = strokePaint.strokeWidth / 2f
+        val radius = (height - strokePaint.strokeWidth) / 2f
+        val mainRight = if (trailingWidth > 0f) width - trailingWidth - trailingGap else width.toFloat()
+        canvas.drawRoundRect(halfStroke, halfStroke, mainRight - halfStroke, height - halfStroke, radius, radius, strokePaint)
+        if (trailingWidth > 0f) canvas.drawRoundRect(width - trailingWidth + halfStroke, halfStroke, width - halfStroke, height - halfStroke, radius, radius, strokePaint)
+        canvas.restoreToCount(saved)
+    }
+}
