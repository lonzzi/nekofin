+package eightbitlab.com.blurview;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.RecordingCanvas;
+import android.os.Build;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.RequiresApi;
+
+/**
+ * A small, invisible BlurView source that reuses the content's recorded RenderNode.
+ * It shares BlurView 3.1's package to access the snapshot without redrawing the View hierarchy.
+ */
+@SuppressLint("ViewConstructor")
+public final class CroppedBlurTarget extends BlurTarget {
+    private final BlurTarget source;
+    private final int[] sourceLocation = new int[2];
+    private final int[] targetLocation = new int[2];
+
+    public CroppedBlurTarget(@NonNull Context context, @NonNull BlurTarget source) {
+        super(context);
+        this.source = source;
+    }
+
+    @RequiresApi(Build.VERSION_CODES.S)
+    public void updateSnapshot() {
+        if (getWidth() <= 0 || getHeight() <= 0 || !source.renderNode.hasDisplayList()) {
+            return;
+        }
+        source.getLocationOnScreen(sourceLocation);
+        getLocationOnScreen(targetLocation);
+        renderNode.setPosition(0, 0, getWidth(), getHeight());
+        RecordingCanvas canvas = renderNode.beginRecording();
+        try {
+            canvas.translate(sourceLocation[0] - targetLocation[0], sourceLocation[1] - targetLocation[1]);
+            canvas.drawRenderNode(source.renderNode);
+        } finally {
+            renderNode.endRecording();
+        }
+    }
+
+    @Override
+    protected void dispatchDraw(@NonNull Canvas canvas) {
+        // Preserve BlurView's rare software/snapshot fallback without changing the normal draw path.
+        if (!canvas.isHardwareAccelerated()) {
+            source.getLocationOnScreen(sourceLocation);
+            getLocationOnScreen(targetLocation);
+            int save = canvas.save();
+            canvas.translate(sourceLocation[0] - targetLocation[0], sourceLocation[1] - targetLocation[1]);
+            source.draw(canvas);
+            canvas.restoreToCount(save);
+        }
+    }
+}
