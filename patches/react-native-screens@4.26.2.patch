new file mode 100644
--- /dev/null
+++ b/CroppedBlurTarget.java
@@ -0,0 +1,107 @@
+package eightbitlab.com.blurview;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.RecordingCanvas;
+import android.graphics.RenderEffect;
+import android.graphics.Shader;
+import android.os.Build;
+import android.view.View;
+import com.facebook.react.views.drawer.ReactDrawerLayout;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.RequiresApi;
+
+/** A content-only, downsampled GPU snapshot shared by native navigation materials. */
+@SuppressLint("ViewConstructor")
+public final class CroppedBlurTarget extends BlurTarget {
+    private static final float SCALE = 4f;
+    private final BlurTarget source;
+    private final int[] sourceLocation = new int[2];
+    private final int[] targetLocation = new int[2];
+    private int previousSourceX = Integer.MIN_VALUE;
+    private int previousSourceY = Integer.MIN_VALUE;
+    private int previousTargetX = Integer.MIN_VALUE;
+    private int previousTargetY = Integer.MIN_VALUE;
+    private int previousClearColor;
+    private boolean hadContent;
+    private int snapshotWidth;
+    private int snapshotHeight;
+
+    public CroppedBlurTarget(@NonNull Context context, @NonNull BlurTarget source) {
+        super(context);
+        this.source = source;
+    }
+
+    @RequiresApi(Build.VERSION_CODES.S)
+    public void updateBlurredSnapshot(int clearColor, boolean anchorDrawer) {
+        if (getWidth() <= 0 || getHeight() <= 0) return;
+        source.getLocationOnScreen(sourceLocation);
+        getLocationOnScreen(targetLocation);
+        // The drawer moves its cached material; sampling stays at the resting layout position.
+        if (anchorDrawer) {
+            android.view.ViewParent parent = getParent();
+            while (parent instanceof View) {
+                targetLocation[0] -= Math.round(((View) parent).getTranslationX());
+                targetLocation[1] -= Math.round(((View) parent).getTranslationY());
+                // Native left drawers change their laid-out left instead of translationX.
+                // Sample at the fully open position while DrawerLayout moves the cached material.
+                if (parent.getParent() instanceof ReactDrawerLayout) {
+                    targetLocation[0] -= ((View) parent).getLeft();
+                }
+                parent = parent.getParent();
+            }
+        }
+        int width = (int) Math.ceil(getWidth() / SCALE);
+        int height = (int) Math.ceil(getHeight() / SCALE);
+        boolean hasContent = source.renderNode.hasDisplayList();
+        if (renderNode.hasDisplayList() && snapshotWidth == width && snapshotHeight == height
+                && previousSourceX == sourceLocation[0] && previousSourceY == sourceLocation[1]
+                && previousTargetX == targetLocation[0] && previousTargetY == targetLocation[1]
+                && previousClearColor == clearColor && hadContent == hasContent) return;
+        previousSourceX = sourceLocation[0];
+        previousSourceY = sourceLocation[1];
+        previousTargetX = targetLocation[0];
+        previousTargetY = targetLocation[1];
+        previousClearColor = clearColor;
+        hadContent = hasContent;
+        if (snapshotWidth != width || snapshotHeight != height) {
+            snapshotWidth = width;
+            snapshotHeight = height;
+            renderNode.setPosition(0, 0, width, height);
+            renderNode.setRenderEffect(RenderEffect.createBlurEffect(20f, 20f, Shader.TileMode.CLAMP));
+        }
+        RecordingCanvas canvas = renderNode.beginRecording();
+        try {
+            canvas.drawColor(clearColor);
+            canvas.scale(1f / SCALE, 1f / SCALE);
+            canvas.translate(sourceLocation[0] - targetLocation[0], sourceLocation[1] - targetLocation[1]);
+            if (source.renderNode.hasDisplayList()) canvas.drawRenderNode(source.renderNode);
+        } finally {
+            renderNode.endRecording();
+        }
+    }
+
+    @RequiresApi(Build.VERSION_CODES.S)
+    public void drawBlurredSnapshot(@NonNull Canvas canvas, @NonNull View destination) {
+        if (!renderNode.hasDisplayList()) return;
+        int saved = canvas.save();
+        canvas.translate(getLeft() - destination.getLeft(), getTop() - destination.getTop());
+        canvas.scale(SCALE, SCALE);
+        canvas.drawRenderNode(renderNode);
+        canvas.restoreToCount(saved);
+    }
+
+    @Override
+    protected void dispatchDraw(@NonNull Canvas canvas) {
+        if (!canvas.isHardwareAccelerated()) {
+            source.getLocationOnScreen(sourceLocation);
+            getLocationOnScreen(targetLocation);
+            int saved = canvas.save();
+            canvas.translate(sourceLocation[0] - targetLocation[0], sourceLocation[1] - targetLocation[1]);
+            source.draw(canvas);
+            canvas.restoreToCount(saved);
+        }
+    }
+}
